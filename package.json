{
  "name": "@noor-mkdad/pharma-dscsa-client",
  "version": "1.0.0",
  "description": "Official zero-dependency, high-speed JavaScript/TypeScript client for FDA DSCSA & EU FMD Drug Serialization API (21 USC 360eee)",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "keywords": [
    "fda-dscsa",
    "eu-fmd",
    "serialization",
    "epcis",
    "21-usc-360eee",
    "gtin",
    "track-and-trace",
    "ndc-converter",
    "pharma"
  ],
  "author": "Noor Mkdad",
  "license": "MIT",
  "homepage": "https://noormkdad.com/tools/pharma-dscsa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrMkdaddy/pharma-dscsa-typescript.git"
  }
}